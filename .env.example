# ==========================================
# InvestorHub Australia Environment Config
# ==========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/investorhub_db?schema=public"

# App Ports & URLs
PORT=4000
API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
FRONTEND_URL="http://localhost:3000"

# --- Vercel (production) ---
# Web project (apps/web): Root Directory = apps/web, enable "Include source files outside Root Directory".
#   API_PROXY_TARGET=https://your-api-project.vercel.app
#   NEXT_PUBLIC_API_URL=/api/v1
#   FRONTEND_URL=https://your-web-project.vercel.app
# API project (apps/api): Root Directory = apps/api, same monorepo setting.
#   DATABASE_URL=<Neon/Supabase Postgres URL>
#   FRONTEND_URL=https://your-web-project.vercel.app
#   JWT_SECRET=<strong random>
#   JWT_REFRESH_SECRET=<strong random>
#   NODE_ENV=production
# Optional: comma-separated extra CORS origins (preview URLs)
# CORS_ORIGINS=https://your-web-project-git-branch.vercel.app

# JWT Auth Secrets
JWT_SECRET="investorhub-super-secret-jwt-key-2026-secure-token"
JWT_REFRESH_SECRET="investorhub-super-secret-refresh-key-2026-secure-token"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Service (Optional - falls back to deterministic NLP heuristics if blank)
AI_PROVIDER="openai" # or "gemini" / "anthropic"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Cloud Object Storage (S3 compatible - mock / cloud)
STORAGE_ENDPOINT=""
STORAGE_BUCKET="investorhub-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="ap-southeast-2"

# Transactional Email (Resend or SMTP)
EMAIL_FROM="InvestorHub Australia <no-reply@investorhub.com.au>"
RESEND_API_KEY=""

# Analytics (Optional)
NEXT_PUBLIC_GA4_ID=""
